        <mxCell id="n24" value="librime 引擎（C++ 核心 · 每台设备各自进程内运行同一套逻辑）" style="swimlane;startSize=30;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;" vertex="1" parent="1"><mxGeometry x="60" y="690" width="1180" height="260" as="geometry" /></mxCell>
        <mxCell id="n25" value="RimeSyncUserData()&#xa;/sync 的统一入口" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="15" y="50" width="214" height="80" as="geometry" /></mxCell>
        <mxCell id="n26" value="SynchronizeAll()&#xa;扫描本机全部 *.userdb&#xa;逐个 db_name 处理" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="249" y="50" width="214" height="80" as="geometry" /></mxCell>
        <mxCell id="n27" value="Synchronize(db_name)&#xa;遍历 sync_dir 下全部&#xa;&lt;installation_id&gt;/ 子目录" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="483" y="50" width="214" height="80" as="geometry" /></mxCell>
        <mxCell id="n28" value="Restore()&#xa;读快照内部 /db_name&#xa;合并进本地同名 userdb" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="717" y="50" width="214" height="80" as="geometry" /></mxCell>
        <mxCell id="n29" value="Backup()&#xa;导出本机快照到&#xa;sync_dir/&lt;本机id&gt;/" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="951" y="50" width="214" height="80" as="geometry" /></mxCell>
        <mxCell id="n30" value="UserDbMerger&#xa;commits/dee/tick 各取 max（时间衰减加权）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n24"><mxGeometry x="717" y="165" width="214" height="60" as="geometry" /></mxCell>
        <mxCell id="n31" value="配对规则：快照文件名 = db_name + .userdb.txt，但合并目标以快照文件内部的 /db_name 元数据为准 ——&#xa;方案决定 db_name，db_name 决定谁能合并（Rime 管合并，git 只管运输）" style="text;html=1;align=left;spacingLeft=8;fontColor=#7a5c00;" vertex="1" parent="n24"><mxGeometry x="15" y="165" width="680" height="60" as="geometry" /></mxCell>
        <mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
