        <mxCell id="n17" value="Squirrel.app（输入法，菜单栏触发部署/同步）&#xa;Contents/MacOS/rime_dict_manager（无头同步工具）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n16"><mxGeometry x="20" y="40" width="560" height="60" as="geometry" /></mxCell>
        <mxCell id="n18" value="Rime 用户目录 ~/Library/Rime" style="swimlane;startSize=30;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="n16"><mxGeometry x="20" y="120" width="700" height="280" as="geometry" /></mxCell>
        <mxCell id="n19" value="输入方案 *.schema.yaml&#xa;rime_mint / melt_eng / …&#xa;translator.dictionary&#xa;→ 决定 db_name" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n18"><mxGeometry x="15" y="40" width="330" height="100" as="geometry" /></mxCell>
