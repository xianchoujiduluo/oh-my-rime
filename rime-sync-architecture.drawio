        <mxCell id="n22" value="lua/（librime-lua 脚本：shijian 日期时间等）· build/（方案编译产物）" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="n18"><mxGeometry x="15" y="215" width="670" height="50" as="geometry" /></mxCell>
